# ── Environment & caches ────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
.mpl_cache/
.pytest_cache/
scratch/

# ── Data: the DataCo dataset is CC BY 4.0 and is NOT redistributed here ──
# Download Mendeley Data V5 (DOI 10.17632/8gx2fvg2k6.5) into data/raw/; processed tables are rebuilt by 01_prepare.py
data/raw/*.csv
data/processed/*.parquet

# ── Model artefacts: built by `python run_all.py`, or restored from demo_artifacts.zip (GitHub Release) ──
# (the Random Forest alone is ~566 MB, over GitHub's 100 MB limit; none of the .joblib files are committed)
models/*.joblib
*.pkl

# ── Release bundles and tool droppings ──
dist/
*.zip
catboost_info/

# ── Local / personal Streamlit state ───────────────────────────
.streamlit/credentials.toml
.streamlit/secrets.toml

# ── Secrets (never commit) ─────────────────────────────────────
.env
*.pem
*.key

# ── Notebooks ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS / IDE ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
